# horcrux configuration — copy to horcrux.env next to the launcher and edit.
# horcrux.sh sources this file with `set -a`, so plain VAR=value lines are
# exported to the app automatically.

# --- Oracle (OpenAI-compatible vision chat endpoint) -------------------------

# REQUIRED. API key sent as `Authorization: Bearer ...`.
#HORCRUX_OPENAI_KEY=sk-...

# Base URL of an OpenAI-compatible API (no trailing slash).
#HORCRUX_OPENAI_BASE=https://api.openai.com/v1

# Vision-capable model name.
#HORCRUX_OPENAI_MODEL=gpt-4o-mini

# Max tokens per reply.
#HORCRUX_OPENAI_MAX_TOKENS=2000

# Sampling temperature (default 0.9 — higher = more varied replies).
#HORCRUX_OPENAI_TEMPERATURE=0.9

# Send "reasoning_split": true in the request. Needed for MiniMax-M3 so its
# chain-of-thought never reaches the page. Default: auto-on when the model
# name contains "minimax".
#HORCRUX_REASONING_SPLIT=off

# --- Appearance ----------------------------------------------------------------

# Path to a .ttf for the diary's handwriting. Default: embedded Dancing
# Script. CedarvilleCursive.ttf is bundled in fonts/ as a more legible
# alternative (SIL OFL).
#HORCRUX_FONT=/home/root/horcrux/fonts/CedarvilleCursive.ttf

# --- Memory ------------------------------------------------------------------

# "off" disables the diary's long-term memory entirely.
#HORCRUX_MEMORY=on

# Where memory pages are stored (index.tsv + <id>.strokes).
#HORCRUX_MEMORY_DIR=/home/root/horcrux-data/memories

# How many recent turns are sent to the oracle as context.
#HORCRUX_MEMORY_TURNS=6

# --- Journal -----------------------------------------------------------------

# "off" disables the daily journal entirely: no auto-composed entry on quit
# and no recall of past entries.
#HORCRUX_JOURNAL=on

# Whole hours added to UTC to get your local "today" (the tablet usually
# runs UTC). Example: 2 for CEST, -5 for EST.
#HORCRUX_TZ_OFFSET=0
