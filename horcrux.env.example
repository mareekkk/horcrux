# Horcrux configuration
#
# Copy this file to /home/root/horcrux/horcrux.env, keep it mode 600, and
# uncomment only the values you want to change. horcrux-run.sh exports these
# shell-style VAR=value lines to the application.
#
# Never commit the real horcrux.env file. Never share it in an issue or log.

# --- Oracle: where the diary's unseen voice comes from -----------------------

# REQUIRED. API key sent in the Authorization header.
#HORCRUX_OPENAI_KEY=CHANGEME

# OpenAI-compatible API base URL, without a trailing slash.
#HORCRUX_OPENAI_BASE=https://api.openai.com/v1

# Vision-capable model name understood by the endpoint.
#HORCRUX_OPENAI_MODEL=gpt-4o-mini

# Maximum generated tokens per ordinary reply.
#HORCRUX_OPENAI_MAX_TOKENS=2000

# Sampling temperature. Higher values make the voice less predictable.
#HORCRUX_OPENAI_TEMPERATURE=0.9

# Send reasoning_split=true. "on" forces it, "off" disables it, and leaving
# it unset enables it automatically for model names containing "minimax".
#HORCRUX_REASONING_SPLIT=off

# --- Handwriting and animation -----------------------------------------------

# Optional path to a TrueType font. The embedded default is Dancing Script.
# Cedarville Cursive is bundled as a more legible, period-like alternative.
#HORCRUX_FONT=/home/root/horcrux/fonts/CedarvilleCursive.ttf

# Milliseconds of quiet after the pen lifts before the page is submitted.
# Range: 250..60000. Default: 3800.
#HORCRUX_IDLE_MS=3800

# Milliseconds between the 26 disappearing-ink stages. Lower is faster.
# Range: 20..2000. Default: 140.
#HORCRUX_DRINK_STAGE_MS=140

# Milliseconds between batches of reply-handwriting points. Lower is faster.
# Range: 4..500. Default: 16.
#HORCRUX_WRITE_TICK_MS=16

# Reply-handwriting points drawn per tick. Higher is faster but less visibly
# stroke-by-stroke. Range: 1..128. Default: 12.
#HORCRUX_WRITE_POINTS_PER_TICK=12

# Milliseconds between the 26 reply-fade stages. Lower is faster.
# Range: 20..2000. Default: 140.
#HORCRUX_FADE_STAGE_MS=140

# --- Conversation memory -----------------------------------------------------

# "off" makes every conversation ephemeral and also prevents journal
# composition, because the diary has no retained pages to summarize.
#HORCRUX_MEMORY=on

# Directory for index.tsv and one <timestamp>.strokes file per page.
#HORCRUX_MEMORY_DIR=/home/root/horcrux-data/memories

# Number of recent turns sent back to the model as conversational context.
# This does not limit how many same-day turns the daily journal summarizes.
#HORCRUX_MEMORY_TURNS=6

# --- The diary's own daily journal -------------------------------------------

# "off" disables daily composition and recall of dated entries.
#HORCRUX_JOURNAL=on

# Directory for YYYY-MM-DD.txt and YYYY-MM-DD.strokes journal pairs. When
# unset, it is a journal/ directory beside HORCRUX_MEMORY_DIR.
#HORCRUX_JOURNAL_DIR=/home/root/horcrux-data/journal

# Stock reMarkable document library where the readable EPUB companion is
# refreshed at session end. The canonical source remains "Horcrux Diary.md"
# inside HORCRUX_JOURNAL_DIR.
#HORCRUX_LIBRARY_DIR=/home/root/.local/share/remarkable/xochitl

# The writer's timezone name shown to the oracle. The offset controls the
# actual clock calculation; this name gives that clock its human location.
#HORCRUX_TZ_NAME=Australia/Perth

# Whole hours added to UTC for the writer's current local date and time.
# Examples: 8 for Australia/Perth, 2 for CEST, -5 for EST. Default: 8.
#HORCRUX_TZ_OFFSET=8
